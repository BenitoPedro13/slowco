{
  "name": "slowco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "playwright test",
    "check:images": ".venv-ig/bin/python -I scripts/images/prepare.py --check public",
    "images:import": ".venv-ig/bin/python -I scripts/images/prepare.py --manifest scripts/images/instagram-picks.tsv --out public/catalogo",
    "check:launch": "node scripts/check-launch.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
